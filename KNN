import matplotlib.pyplot as plt
 
def convertirBalizas(balizas, columnas, filas, anchoPlano, altoPlano):
    tamCeldaX=anchoPlano/columnas #1.1988
    tamCeldaY=altoPlano/filas #0.813
    balizasReales = {}
    for id, (fila, columna) in balizas.items():
        x_real = columna * tamCeldaX
        y_real = fila * tamCeldaY
        balizasReales[id] = (x_real, y_real)
   
    return balizasReales
 
def graficarBalizas(balizasReales):
    # Extraer para graficar
    ids = list(balizasReales.keys())
    xs = [balizasReales[i][0] for i in ids]
    ys = [balizasReales[i][1] for i in ids]
 
    # Graficar
    plt.figure(figsize=(8, 6))
    plt.scatter(xs, ys, c='blue', s=100, label='Balizas (en metros)')
    for i, (x, y) in zip(ids, zip(xs, ys)):
        plt.text(x + 0.1, y + 0.1, f'ID {i}', fontsize=9)
 
    plt.grid(True)
    plt.xlabel("X (metros)")
    plt.ylabel("Y (metros)")
    plt.title("Posiciones de las balizas en metros")
    plt.legend()
    plt.show()
 
def posicionesEnMetros(df, columnas, filas, anchoPlano, altoPlano):
    tamCeldaX=anchoPlano/columnas #1.1988
    tamCeldaY=altoPlano/filas #0.813
    posiciones = []
    for i in df.itertuples():
        x_real = i.Columna * tamCeldaX
        y_real = i.Fila * tamCeldaY
        posiciones.append([x_real, y_real])
   
    return posiciones
