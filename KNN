def ajustar_a_pasillo(posicion, pasillos):
    """
    posicion: tu predicción (x, y) en coordenadas reales o del plano
    pasillos: lista de tuplas válidas
    """
    x_pred, y_pred = posicion
    pasillos = np.array(pasillos)
 
    # Calcular distancias euclídeas a cada punto válido en pasillos
    distancias = np.sqrt((pasillos[:,0] - x_pred)**2 + (pasillos[:,1] - y_pred)**2)
 
    # Elegir el punto más cercano
    indice_mas_cercano = np.argmin(distancias)
    return tuple(pasillos[indice_mas_cercano])
 
def mostrarError(nombreModelo,y_pred_real,y_real,y_test_real):
    # Mostrar los primeros 10 resultados redondeados
    print("Comparación de las primeras 10 predicciones:")
    for i in range(10):
        pred_x, pred_y = y_pred_real[i]
        real_x, real_y = y_real[i]
        # Se redondea y convierte a entero para la visualización
        print(f"Predicho: ({int(round(pred_x))}, {int(round(pred_y))}) | Real: ({int(round(real_x))}, {int(round(real_y))})")
 
    # Cálculo de errores en metros
    errores = np.sqrt(np.sum((y_test_real - y_pred_real)**2, axis=1))
    print(f"Error promedio de localización con {nombreModelo}: {np.mean(errores):.2f} metros")
    print(f"Error máximo con {nombreModelo}: {np.max(errores):.2f} metros")

